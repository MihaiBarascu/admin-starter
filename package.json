    "vite": "^6.4.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.87.0"
  },
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "tsc && vite build && wrangler deploy --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply multiwebsite-admin-starter-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply multiwebsite-admin-starter-db --remote",
    "deploy": "wrangler deploy",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "npm run build && vite preview",
    "test:api": "vitest run --config vitest.worker.config.ts",
    "test:api:watch": "vitest --config vitest.worker.config.ts"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
