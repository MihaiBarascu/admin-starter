{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multiwebsite-admin-starter",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "admin-starter.multiwebsite.org",
      "custom_domain": true
    }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "BETTER_AUTH_URL": "https://admin-starter.multiwebsite.org",
    "AUTH_TRUSTED_ORIGINS": "https://admin-starter.multiwebsite.org",
    "AUTH_SIGNUP_ENABLED": "false",
    "APP_NAME": "Multiwebsite Admin Starter"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "multiwebsite-admin-starter",
      "database_id": "8bc28ac4-57fd-4f70-a43b-63d76e2707f0",
      "migrations_dir": "./drizzle/migrations"
    }
  ]
}
